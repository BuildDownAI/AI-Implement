# =============================================================================
# Ticketing provider — configure at least one (Linear or Jira)
# =============================================================================

# Linear — OAuth app credentials (client-credentials grant). Create the app at
# Settings → API → Applications and enable "client credentials tokens".
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Workspace URL is used to build issue links in notifications and admin UI.
LINEAR_WORKSPACE_URL=https://linear.app/your-workspace

# Jira (Cloud) — two auth modes; pick ONE.
#
# 1. Basic auth with an API token (recommended — long-lived, no refresh):
#    set JIRA_EMAIL + JIRA_TOKEN (an id.atlassian.com API token) + JIRA_SITE_URL.
#    Calls go to JIRA_SITE_URL directly; JIRA_CLOUD_ID is not needed.
#
# 2. OAuth 2.0 (Bearer): leave JIRA_EMAIL blank and set JIRA_TOKEN (an OAuth
#    access token) + JIRA_CLOUD_ID + JIRA_SITE_URL. Calls route through
#    api.atlassian.com/ex/jira/{cloudId}. Access tokens are short-lived.
#    JIRA_CLOUD_ID is the GUID from https://your-domain.atlassian.net/_edge/tenant_info.
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_CLOUD_ID=
JIRA_SITE_URL=https://your-domain.atlassian.net

# =============================================================================
# GitHub App — required
# =============================================================================

GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook secret (HMAC-SHA256) for validating GitHub webhook payloads.
# Powers two features:
#   1. PR-merge reconciliation: closed+merged pull_request events → mark tracker issue Done.
#   2. /ai-implement comment handling: issue_comment events on envelope-generation repos →
#      orchestrator-dispatched gap-fill run (replaces comment-trigger.yml for those repos).
# Configure a GitHub App or repo/org webhook pointing to
# https://<orchestrator>/api/github/webhook with this secret. Subscribe to
# at least `pull_request` (for reconciliation) and `issue_comment` (for /ai-implement).
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# Runner mode — selects how target-repo workflows execute
# =============================================================================

# "fly"     — boot a one-shot Fly Machine per dispatch
# "gha"     — dispatch GitHub Actions workflow_dispatch in target repo
# "local"   — boot a one-shot local Docker container per dispatch
# "default" — use each project's configured execution mode
# "shadow"  — dispatch GitHub Actions as primary and Fly Machines as secondary
RUNNER_MODE=fly

# --- Local Docker runner (RUNNER_MODE=local) ---------------------------------

# Local runner image used by `npm run dev:local`.
LOCAL_RUNNER_IMAGE=ai-implement-runner:local
# Optional URL local Docker containers use to reach this orchestrator.
# Defaults to http://host.docker.internal:${PORT}.
LOCAL_RUNNER_ORCHESTRATOR_URL=

# --- Fly Machines runner (RUNNER_MODE=fly) ------------------------------------

# Fly app that hosts session machines (separate from the orchestrator's own app).
FLY_SESSIONS_APP=
FLY_SESSIONS_REGION=iad
# Fly API token scoped to the sessions app (use `fly tokens create deploy`).
FLY_SESSIONS_TOKEN=

# Process-level secrets — env override for the UI toggle on the Runners page.
# The setting is normally controlled via the admin UI (Runners page) and persisted
# in the settings table; this variable overrides the UI toggle at runtime and shows
# a disabled-toggle warning in the UI.
#
# Process-level mode is ON by default (the safer boundary: foreign-team secrets
# are excluded at Fly rather than filtered inside the machine entrypoint).
# Set to false/0/no to force entrypoint mode, where Fly injects all secrets and
# the runner entrypoint removes foreign ones after injection.
# Accepted truthy values: true, 1, yes (case-insensitive).
# Accepted falsy values: false, 0, no (case-insensitive) — explicitly disables.
# Unset or empty means the UI toggle applies (which itself defaults to on).
#
# buildSessionMachineConfig populates processes[0].ignore_app_secrets=true and
# processes[0].secrets with only the dispatched team's own secrets (remapped to
# bare names) plus global secrets, keeping foreign-team secrets out at the Fly
# boundary. If the orchestrator cannot list the sessions app's secrets at dispatch,
# process-level mode sends an empty list with ignore_app_secrets=true, so the
# machine gets no per-project secrets and a hook that needs one fails loudly.
FLY_PROCESS_LEVEL_SECRETS=

# Orchestrator default runner image (both execution modes; formerly SESSION_IMAGE).
# Override per-repo via .ai-implement/image.yml.
AI_IMPLEMENT_RUNNER_IMAGE=ghcr.io/builddownai/ai-implement-runner:latest

# Runner authentication for Claude inside the session — set one of:
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# =============================================================================
# Runner → orchestrator callback (all execution modes)
# =============================================================================

# Public base URL runners use to POST progress and results back to the
# orchestrator (e.g. https://your-orchestrator.fly.dev). This is not Fly-specific:
# Fly Machines, GitHub Actions, and local Docker all report through it, and the
# GHA path receives it as a workflow input rather than an environment variable.
# Without this and RUNNER_TOKEN_SECRET, runner-callback features are disabled.
# Planning dispatch is refused outright when either is missing (AII-430): a
# planning run that cannot report never reaches Plan-Complete, and planning
# carries no dedup entry, so the issue would re-dispatch every poll forever.
# Local dev (`npm run dev:local`, RUNNER_MODE=local) defaults this to
# http://host.docker.internal:$PORT automatically — leave it blank there.
RUNNER_CALLBACK_BASE_URL=
# Shared secret used to sign/verify runner callback tokens (HMAC). Unlike the
# base URL above, this has no local-dev default — planning is refused without it.
RUNNER_TOKEN_SECRET=

# Shared secret for the /api/gap-fill-trigger endpoint that the comment-trigger
# workflow uses to kick off gap-fill runs against an existing PR.
GAP_FILL_TRIGGER_SECRET=

# =============================================================================
# Notifications (optional)
# =============================================================================

NOTIFY_TYPE=slack            # slack | teams
NOTIFY_WEBHOOK_URL=          # leave blank to disable

# =============================================================================
# Admin UI auth (optional — UI disabled if neither SSO nor the access code is set)
# =============================================================================

# Deprecated shared access code (fallback). Prefer SSO below. The UI is enabled
# if this OR any OAuth provider is set; using it logs a deprecation warning.
ADMIN_ACCESS_CODE=your-secret-access-code

# --- SSO via OIDC (Google and/or Microsoft) ----------------------------------

# Base URL for OAuth redirect URIs — where providers redirect back after login
# (e.g. https://your-orchestrator.fly.dev; http://localhost:8080 locally).
OAUTH_REDIRECT_BASE_URL=

# Google — create a Web OAuth client at console.cloud.google.com → Credentials;
# redirect URI ${OAUTH_REDIRECT_BASE_URL}/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft (Entra) — register a Web app; redirect URI
# ${OAUTH_REDIRECT_BASE_URL}/api/auth/microsoft/callback. TENANT must be a
# specific single-tenant GUID — a multi-tenant value (common/organizations/
# consumers) disables Microsoft SSO, since the tid-based verification is unsafe there.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=

# Authorization allowlist (fail-closed) — a verified email must match one of these
# to be admitted. Comma-separated. Empty = deny everyone (SSO effectively locked out).
#
# These SEED the allowlist rather than being it. They apply while nothing is stored;
# the first save on /admin#access hands authority to the database permanently, and
# from then on these are shown on that page as stale and never consulted again.
#
# A domain admits its members as `user`; only a listed address can be `admin`. So
# OAUTH_ALLOWED_EMAILS is required to ADMINISTER an SSO deployment — with domains
# alone everyone signs in and every /api/ route answers 403, and the sign-in page
# says so. A `user` still reaches /mcp, which no page grant governs, so this gates
# the admin UI rather than the data. Polling and dispatch run either way, and the
# access-code path is unaffected.
# Full reference: docs/access-model.md
OAUTH_ALLOWED_DOMAINS=your-company.com
OAUTH_ALLOWED_EMAILS=you@your-company.com

# =============================================================================
# MCP server — OAuth-authenticated proxy to the KG sidecar
# =============================================================================

# URL of the private KG sidecar (streamable-HTTP MCP transport).
# In the orchestrator Docker image, docker-entrypoint.sh sets this automatically
# when the bundled KG sidecar starts (127.0.0.1:8765). Leave blank here for
# Docker deployments. For local dev (npm run dev), start the sidecar manually
# and set this explicitly; unset → /mcp returns 503.
KG_SIDECAR_URL=
# Memory provider ID for /mcp. Default: "sidecar" (the bundled KG sidecar).
# An external provider can be registered in src/kg-provider.ts; see docs/kg-sidecar.md
# for the provider contract. Leave unset to use the default sidecar provider.
MEMORY_PROVIDER=
# GitHub owner/repo for the knowledge-graph source cloned into the orchestrator
# image at build time. Required to serve a knowledge graph; unset builds without one.
KG_SOURCE_REPO=
#
# MCP clients authenticate via OAuth 2.0 (no pre-shared secret).
# Requires OAUTH_REDIRECT_BASE_URL + at least one OAuth provider configured above.
# The /mcp endpoint returns 401 → /.well-known/oauth-protected-resource → browser SSO.
# Dynamic clients may use loopback IP-literal HTTP callbacks. Comma-separate any HTTPS
# origins that should also be accepted; arbitrary HTTPS callbacks are denied.
MCP_ALLOWED_REDIRECT_ORIGINS=
# Access-token lifetime in seconds (default 3600). Refresh tokens last 30 days and
# rotate on use, so clients re-authenticate in a browser monthly, not hourly.
MCP_ACCESS_TOKEN_TTL=
# MCP OIDC redirect URIs to register in Google/Microsoft consoles:
#   ${OAUTH_REDIRECT_BASE_URL}/mcp/callback/google
#   ${OAUTH_REDIRECT_BASE_URL}/mcp/callback/microsoft

# =============================================================================
# Service
# =============================================================================

PORT=8080

# The orchestrator's single scheduling clock. One tick drives dispatch, monitoring, the reaper,
# merge-ups, reconciliation and the self-deploy check, and periodic behaviour elsewhere derives
# from this value rather than keeping its own timer — including how long the sign-in allowlist
# may serve from memory before re-reading, which is what lets the recovery command take effect
# without a restart. Lowering it raises tracker API traffic proportionally.
POLL_INTERVAL_MS=60000

# Maximum wall-clock time a single poll cycle may run before being abandoned (ms). When the
# deadline fires the cycle is logged and notified once, pollInProgress clears, and the next
# tick starts a fresh cycle. The abandoned body keeps running but cannot dispatch.
POLL_CYCLE_TIMEOUT_MS=600000

# Timeout applied to every outbound GitHub/Linear/Jira fetch (ms). Prevents a single stalled HTTP
# call from hanging the poll cycle indefinitely.
FETCH_TIMEOUT_MS=60000

DEDUP_DB_PATH=./dedup.sqlite

# Used as the tenant id in multi-client deploys (falls back to FLY_APP_NAME).
CLIENT_SLUG=
# The orchestrator's own Fly app name (set automatically on Fly).
FLY_APP_NAME=

# =============================================================================
# Self-deploy — orchestrator redeploys itself when its own branch moves
# =============================================================================

# Fly deploy token — lets the orchestrator build and release its own next version.
# NOT the same as FLY_SESSIONS_TOKEN, which is scoped to the sessions app and cannot
# deploy this one. Create a deploy token scoped to this app only:
#   fly tokens create deploy --app <this-app> --expiry 8760h
# Unset: self-deploy is unavailable; everything else runs normally.
FLY_DEPLOY_TOKEN=

# Nothing else to set here. The image build stamps all three (Dockerfile build args
# SOURCE_COMMIT / SOURCE_REPO / SOURCE_BRANCH):
#
#   AI_IMPLEMENT_SOURCE_COMMIT   commit the image was built from
#   AI_IMPLEMENT_SOURCE_REPO     owner/repo it was built from
#   AI_IMPLEMENT_SOURCE_BRANCH   branch it was built from — and the one watched
#
# Stamping rather than configuring means the three cannot disagree: an operator
# cannot point a testing-built image at main and have it report a deployment as
# permanently available. A build that omits them leaves the feature inert and
# availability reads "unknown", never "up to date".
#
# Setting them in a local .env is fine for exercising the feature without
# building an image — just remember they then describe nothing real.

# =============================================================================
# Dispatch breaker — circuit breaker for consecutive failed dispatches
# =============================================================================

# Consecutive failed dispatches per issue and phase before the orchestrator
# parks the issue; 0 disables; default 3.
DISPATCH_BREAKER_THRESHOLD=3

# =============================================================================
# Reaper — reconciles stuck/orphaned session machines (Fly Machines mode)
# =============================================================================

# When true, the reaper logs what it would do but doesn't destroy machines.
REAPER_DRY_RUN=false
# Alert (via notification adapter) when more than N machines are reaped in a sweep.
REAPER_ALERT_THRESHOLD=10
