{
  // Type-checks every .ts file under src/, tests included, which tsconfig.json
  // excludes. `npm run typecheck` runs this after the plain pass.
  // The explicit "exclude" key is required: without one, `extends` inherits
  // "src/__tests__" from tsconfig.json and no test file is checked.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
