{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dispatchId": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "maxLength": 2000
    },
    "conclusion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycleOwner": {
      "type": "string",
      "enum": [
        "legacy",
        "restate"
      ]
    },
    "dispatchedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "completedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "changedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "issue": {
      "type": "object",
      "properties": {
        "identifier": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "trackerKind": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "identifier",
        "title",
        "repo",
        "trackerKind",
        "url"
      ],
      "additionalProperties": false
    },
    "pr": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "url",
        "number"
      ],
      "additionalProperties": false
    },
    "pushedShas": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "string",
      "enum": [
        "unknown",
        "partial",
        "reported"
      ]
    },
    "invocations": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "maxLength": 2000
          },
          "agent": {
            "type": "string",
            "maxLength": 2000
          },
          "provider": {
            "type": "string",
            "maxLength": 2000
          },
          "model": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "maxLength": 2000
          },
          "tokensIn": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tokensOut": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cacheReadTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cacheCreationTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "costUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "costStatus": {
            "type": "string",
            "enum": [
              "reported",
              "unavailable"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "stage",
          "agent",
          "provider",
          "model",
          "status",
          "tokensIn",
          "tokensOut",
          "cacheReadTokens",
          "cacheCreationTokens",
          "costUsd",
          "costStatus",
          "attempts"
        ],
        "additionalProperties": false
      }
    },
    "compute": {
      "type": "object",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "cpuKind": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "cpus": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryMb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "stoppedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "backend",
        "cpuKind",
        "cpus",
        "memoryMb",
        "startedAt",
        "stoppedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dispatchId",
    "phase",
    "status",
    "conclusion",
    "lifecycleOwner",
    "dispatchedAt",
    "completedAt",
    "changedAt",
    "issue",
    "pr",
    "pushedShas",
    "usage",
    "invocations",
    "compute"
  ],
  "additionalProperties": false
}
