{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "object",
      "properties": {
        "changedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "dispatchId": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|log-[1-9][0-9]{0,15}|reviewfix-[0-9a-f]{64}(?:-[1-9][0-9]{0,2})?)$"
        }
      },
      "required": [
        "changedAt",
        "dispatchId"
      ],
      "additionalProperties": false
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "includeUnsettled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
