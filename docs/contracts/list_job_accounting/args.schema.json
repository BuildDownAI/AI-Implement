{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "object",
      "properties": {
        "changedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dispatchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "changedAt",
        "dispatchId"
      ],
      "additionalProperties": false
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "includeUnsettled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
